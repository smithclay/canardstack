project_id           = "my-project"
region               = "us-central1"
service_name         = "canardstack"
catalog_service_name = "canardstack-catalog"
# catalog_image defaults to the app image (runs `canardstack serve-catalog`);
# set it only to pin a different catalog build.
# catalog_image      = "ghcr.io/smithclay/canardstack:latest"
api_key              = "replace-with-a-long-random-value"
admin_api_key        = "replace-with-a-different-long-random-value"
quack_token          = "replace-with-a-third-long-random-value"

# Leave bucket_name empty to generate a globally unique bucket name.
bucket_name_prefix = "canardstack-ducklake"

# Leave empty for IAM-only invocation. Use ["allUsers"] for a public endpoint
# protected by CANARDSTACK_API_KEY and CANARDSTACK_ADMIN_API_KEY.
invoker_members = []

# The catalog service defaults to public ingress over Cloud Run-managed TLS,
# gated by the shared quack_token (CANARDSTACK_DUCKLAKE_QUACK_TOKEN). For a
# private catalog, set catalog_ingress = "INGRESS_TRAFFIC_INTERNAL_ONLY" and give
# the app VPC egress.
catalog_invoker_members = ["allUsers"]
