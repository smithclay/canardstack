# Env vars override config.toml. Prefer config/example.toml for the primary
# operator config file, then use env vars for deployment-specific overrides.
# CANARDSTACK_CONFIG=/etc/canardstack/config.toml
CANARDSTACK_BIND=127.0.0.1:4318
CANARDSTACK_API_KEY=dev-canardstack-key
CANARDSTACK_ADMIN_API_KEY=dev-canardstack-admin-key
CANARDSTACK_DATA_DIR=.canardstack
# Optional. Docker sets this to the baked extension cache.
# CANARDSTACK_DUCKDB_EXTENSION_DIR=/usr/local/lib/duckdb/extensions

# For a DuckLake PostgreSQL metadata catalog, create the database first and set:
# CANARDSTACK_POSTGRES_DSN=dbname=ducklake_catalog host=localhost user=postgres password=postgres
#
# For a read-write MotherDuck-hosted DuckLake, set the attach URI and provide a
# MotherDuck token. Keep CANARDSTACK_POSTGRES_DSN unset in this mode.
# CANARDSTACK_DUCKLAKE_ATTACH_URI=md:test-ducklake
# motherduck_token=<your-motherduck-token>

# Uses DuckDB's official DuckLake extension SQL path. Startup fails if the
# extension/catalog cannot attach; there is no non-DuckLake ingest fallback.

CANARDSTACK_MAX_BODY_BYTES=8388608
CANARDSTACK_INGEST_MEMORY_BYTES=2147483648
# Optional hard RSS admission limit; unset/empty disables runtime RSS checks.
CANARDSTACK_PROCESS_MEMORY_LIMIT_BYTES=
CANARDSTACK_FLUSH_TARGET_BYTES=4194304
CANARDSTACK_FLUSH_MAX_AGE_SECS=10
CANARDSTACK_ACCEPT_LATE_SECS=86400
CANARDSTACK_ACCEPT_FUTURE_SECS=600
CANARDSTACK_DUCKDB_MEMORY_LIMIT=1GiB
CANARDSTACK_SEGMENT_TARGET_BYTES=67108864
CANARDSTACK_SEGMENT_MAX_AGE_SECS=10
# Per raw-spool lane; logs, spans, metric_gauge, and metric_sum can use about 4x this in aggregate.
CANARDSTACK_RAW_SPOOL_CAPACITY_BYTES=1073741824
CANARDSTACK_RAW_SPOOL_GROUP_COMMIT_MS=1
CANARDSTACK_QUERY_CONCURRENCY=4
CANARDSTACK_QUERY_TIMEOUT_SECS=15
CANARDSTACK_QUERY_MEMORY_LIMIT=1GiB
CANARDSTACK_FLUSH_LANE_CAPACITY=1
CANARDSTACK_CHEAP_QUERY_LANE_CAPACITY=1
CANARDSTACK_HEAVY_QUERY_DEGRADED_CAPACITY=1
CANARDSTACK_FRESHNESS_SLA_SECS=15
CANARDSTACK_RETENTION_DAYS=14
CANARDSTACK_MAX_CONNECTIONS=1024
CANARDSTACK_SOCKET_READ_TIMEOUT_SECS=30
CANARDSTACK_SOCKET_WRITE_TIMEOUT_SECS=30
CANARDSTACK_BENCH_HTTP_KEEPALIVE=true

# Background maintenance. The serve command spawns one thread that runs:
#   - queue watchdog
#   - ingest flush and DuckLake inlined-data flush
#   - discovery metadata refresh
#   - operator metrics snapshot
#   - retention and cleanup
CANARDSTACK_SCHEDULER_ENABLED=true
CANARDSTACK_MAINTENANCE_INTERVAL_SECS=30
