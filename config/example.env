# Env vars override config.toml. Prefer config/example.toml for the primary
# operator config file, then use env vars for deployment-specific overrides.
# CANARDSTACK_CONFIG=/etc/canardstack/config.toml
CANARDSTACK_BIND=127.0.0.1:4318
CANARDSTACK_API_KEY=dev-canardstack-key
CANARDSTACK_ADMIN_API_KEY=dev-canardstack-admin-key
CANARDSTACK_DATA_DIR=.canardstack
CANARDSTACK_DUCKDB_PATH=.canardstack/canardstack.duckdb
CANARDSTACK_STORAGE_DIR=.canardstack/storage
# Optional. Docker sets this to the baked extension cache.
# CANARDSTACK_DUCKDB_EXTENSION_DIR=/usr/local/lib/duckdb/extensions

# For a DuckLake PostgreSQL metadata catalog, create the database first and set:
# CANARDSTACK_POSTGRES_DSN=dbname=ducklake_catalog host=localhost user=postgres password=postgres
#
# For a read-write MotherDuck-hosted DuckLake, set the attach URI and provide a
# MotherDuck token. Keep CANARDSTACK_POSTGRES_DSN unset in this mode.
# CANARDSTACK_DUCKLAKE_ATTACH_URI=md:test-ducklake
# motherduck_token=<your-motherduck-token>

# Uses DuckDB's official DuckLake extension SQL path. Startup fails if the
# extension/catalog cannot attach; there is no non-DuckLake ingest fallback.

CANARDSTACK_MAX_BODY_BYTES=8388608
CANARDSTACK_PER_SIGNAL_QUEUE_BYTES=536870912
CANARDSTACK_PROCESS_INGEST_BYTES=2147483648
# Optional hard RSS admission limit; unset/empty disables runtime RSS checks.
CANARDSTACK_RUNTIME_MEMORY_LIMIT_BYTES=
CANARDSTACK_MAX_ROWS_PER_FLUSH=5000
CANARDSTACK_MAX_BYTES_PER_FLUSH=4194304
CANARDSTACK_MAX_FLUSH_AGE_SECS=10
CANARDSTACK_HIGH_PRESSURE_FLUSH_AGE_SECS=2
CANARDSTACK_ACCEPT_LATE_SECS=86400
CANARDSTACK_ACCEPT_FUTURE_SECS=600
CANARDSTACK_DUCKDB_WRITE_MEMORY_LIMIT=1GiB
CANARDSTACK_IMMUTABLE_SEGMENT_TARGET_BYTES=67108864
CANARDSTACK_IMMUTABLE_SEGMENT_MAX_AGE_SECS=10
CANARDSTACK_DUCKLAKE_DATA_INLINING_ROW_LIMIT=0

# Durable raw-spool acceptance. 202 responses wait for the local raw request to
# be fsynced by the writer thread. Group commit amortizes fsync cost across up
# to this many records or this much time, whichever comes first. Smaller values
# lower acknowledgement latency but raise fsync pressure; larger values improve
# throughput at the cost of p95/p99 ingest acknowledgement latency.
CANARDSTACK_RAW_SPOOL_DIR=.canardstack/raw-spool
CANARDSTACK_RAW_SPOOL_MAX_SEGMENT_BYTES=67108864
CANARDSTACK_RAW_SPOOL_MAX_RECORD_BYTES=8388608
CANARDSTACK_RAW_SPOOL_MAX_TOTAL_BYTES=1073741824
CANARDSTACK_RAW_SPOOL_WRITER_QUEUE_CAPACITY=1024
CANARDSTACK_RAW_SPOOL_GROUP_COMMIT_RECORDS=64
CANARDSTACK_RAW_SPOOL_GROUP_COMMIT_MS=1

CANARDSTACK_QUERY_INTERACTIVE_CONCURRENCY=4
CANARDSTACK_QUERY_BACKGROUND_CONCURRENCY=2
CANARDSTACK_QUERY_INTERACTIVE_TIMEOUT_SECS=15
CANARDSTACK_QUERY_BACKGROUND_TIMEOUT_SECS=60
CANARDSTACK_QUERY_INTERACTIVE_MEMORY_LIMIT=1GiB
CANARDSTACK_QUERY_BACKGROUND_MEMORY_LIMIT=1GiB
CANARDSTACK_LOGS_RETENTION_DAYS=14
CANARDSTACK_SPANS_RETENTION_DAYS=14
CANARDSTACK_METRICS_RETENTION_DAYS=30
CANARDSTACK_MAX_CONNECTIONS=1024
CANARDSTACK_SOCKET_READ_TIMEOUT_SECS=30
CANARDSTACK_SOCKET_WRITE_TIMEOUT_SECS=30
CANARDSTACK_FORCE_DEPENDENCY_UNHEALTHY=false
CANARDSTACK_BENCH_HTTP_KEEPALIVE=false

# Background scheduler. The serve command spawns one thread that runs:
#   - queue watchdog: flush per-signal queues whose oldest batch exceeded max_age
#   - periodic flush: ingest queues + DuckLake inlined data
#   - metadata refresh: re-aggregate discovery summaries for buckets dirtied by ingest
#   - operator metrics snapshot: write canardstack's own /metrics samples to metric tables
#   - compaction: reports disabled for immutable telemetry segments
#   - retention: enforce retention_days, expire snapshots, cleanup old files
# Set CANARDSTACK_SCHEDULER_ENABLED=false to require operator-triggered maintenance.
CANARDSTACK_SCHEDULER_ENABLED=true
CANARDSTACK_SCHEDULER_WATCHDOG_MS=1000
CANARDSTACK_SCHEDULER_FLUSH_SECS=30
CANARDSTACK_SCHEDULER_METADATA_SECS=30
CANARDSTACK_SCHEDULER_METRICS_SECS=60
CANARDSTACK_SCHEDULER_COMPACTION_SECS=300
CANARDSTACK_SCHEDULER_RETENTION_SECS=3600
