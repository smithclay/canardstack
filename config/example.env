CANARDSTACK_BIND=127.0.0.1:4318
CANARDSTACK_API_KEY=dev-canardstack-key
CANARDSTACK_ADMIN_API_KEY=dev-canardstack-admin-key
CANARDSTACK_DATA_DIR=.canardstack
CANARDSTACK_DUCKDB_PATH=.canardstack/canardstack.duckdb
CANARDSTACK_STORAGE_DIR=.canardstack/storage
# Optional. Docker sets this to the baked extension cache.
# CANARDSTACK_DUCKDB_EXTENSION_DIR=/usr/local/lib/duckdb/extensions

# For a DuckLake PostgreSQL metadata catalog, create the database first and set:
# CANARDSTACK_POSTGRES_DSN=dbname=ducklake_catalog host=localhost user=postgres password=postgres
#
# For a read-write MotherDuck-hosted DuckLake, set the attach URI and provide a
# MotherDuck token. Keep CANARDSTACK_POSTGRES_DSN unset in this mode.
# CANARDSTACK_DUCKLAKE_ATTACH_URI=md:test-ducklake
# motherduck_token=<your-motherduck-token>

# Uses DuckDB's official ducklake extension SQL path. Set false for offline tests only.
CANARDSTACK_USE_DUCKLAKE=true
# When DuckLake is enabled, startup fails if the extension/catalog cannot attach.
# Set true only for explicit local fallback testing.
CANARDSTACK_ALLOW_LOCAL_FALLBACK=false

CANARDSTACK_MAX_BODY_BYTES=8388608
CANARDSTACK_PER_SIGNAL_QUEUE_BYTES=536870912
CANARDSTACK_PROCESS_INGEST_BYTES=2147483648
CANARDSTACK_MAX_ROWS_PER_FLUSH=200000
CANARDSTACK_MAX_BYTES_PER_FLUSH=134217728
CANARDSTACK_MAX_FLUSH_AGE_SECS=10
CANARDSTACK_HIGH_PRESSURE_FLUSH_AGE_SECS=2
CANARDSTACK_ACCEPT_LATE_SECS=86400
CANARDSTACK_ACCEPT_FUTURE_SECS=600
CANARDSTACK_QUERY_INTERACTIVE_CONCURRENCY=4
CANARDSTACK_QUERY_BACKGROUND_CONCURRENCY=2
CANARDSTACK_QUERY_INTERACTIVE_TIMEOUT_SECS=15
CANARDSTACK_QUERY_BACKGROUND_TIMEOUT_SECS=60
CANARDSTACK_QUERY_INTERACTIVE_MEMORY_LIMIT=512MiB
CANARDSTACK_QUERY_BACKGROUND_MEMORY_LIMIT=1GiB
CANARDSTACK_LOGS_RETENTION_DAYS=14
CANARDSTACK_SPANS_RETENTION_DAYS=14
CANARDSTACK_METRICS_RETENTION_DAYS=30

# Background scheduler. The serve command spawns one thread that runs:
#   - queue watchdog: flush per-signal queues whose oldest batch exceeded max_age
#   - periodic flush: ingest queues + DuckLake inlined data
#   - retention: enforce retention_days, expire snapshots, cleanup old files
# Set CANARDSTACK_SCHEDULER_ENABLED=false to require operator-triggered maintenance.
CANARDSTACK_SCHEDULER_ENABLED=true
CANARDSTACK_SCHEDULER_WATCHDOG_MS=1000
CANARDSTACK_SCHEDULER_FLUSH_SECS=30
CANARDSTACK_SCHEDULER_RETENTION_SECS=3600
