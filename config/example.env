# Env vars override config.toml. Prefer config/example.toml for shared config,
# then use env vars for deployment-specific overrides.
# CANARDSTACK_CONFIG=/etc/canardstack/config.toml

CANARDSTACK_BIND=127.0.0.1:4318
CANARDSTACK_API_KEY=dev-canardstack-key
CANARDSTACK_ADMIN_API_KEY=dev-canardstack-admin-key
CANARDSTACK_DATA_DIR=.canardstack

# Optional. Set when DuckDB extensions are preinstalled in an image/cache.
# CANARDSTACK_DUCKDB_EXTENSION_DIR=/usr/local/lib/duckdb/extensions

# Point canardstack at the DuckLake catalog written by duckdb-otlp.
# CANARDSTACK_DUCKLAKE_ATTACH_URI=ducklake:/var/lib/canardstack/catalog.ducklake
# CANARDSTACK_DUCKLAKE_DATA_PATH=/var/lib/canardstack/storage
#
# MotherDuck-backed DuckLake:
# CANARDSTACK_DUCKLAKE_ATTACH_URI=md:test-ducklake
# motherduck_token=<your-motherduck-token>
#
# PostgreSQL metadata catalog:
# CANARDSTACK_POSTGRES_DSN=dbname=ducklake_catalog host=localhost user=postgres password=postgres

# Object-store DATA_PATH examples. DuckDB resolves ambient credentials through
# credential_chain for s3://, s3a://, gcs://, and gs:// paths.
# CANARDSTACK_DUCKLAKE_DATA_PATH=s3://canardstack-data/prod/
# CANARDSTACK_OBJECT_STORE_REGION=us-west-2

# Query server limits.
CANARDSTACK_QUERY_CONCURRENCY=4
CANARDSTACK_QUERY_TIMEOUT_SECS=15
CANARDSTACK_QUERY_MEMORY_LIMIT=1GiB
CANARDSTACK_QUERY_ADMISSION_WAIT_MS=1000
CANARDSTACK_CHEAP_QUERY_ADMISSION_CAPACITY=1
CANARDSTACK_HEAVY_QUERY_DEGRADED_CAPACITY=1

CANARDSTACK_MAX_CONNECTIONS=1024
CANARDSTACK_SOCKET_READ_TIMEOUT_SECS=30
CANARDSTACK_SOCKET_WRITE_TIMEOUT_SECS=30

# Optional in-binary TLS for the public serve endpoint. Requires `--features tls`.
# CANARDSTACK_TLS_ENABLED=true
# CANARDSTACK_TLS_MODE=file
# CANARDSTACK_TLS_CERT_FILE=/etc/canardstack/tls/fullchain.pem
# CANARDSTACK_TLS_KEY_FILE=/etc/canardstack/tls/privkey.pem
# CANARDSTACK_TLS_BACKEND_BIND=127.0.0.1:4319
